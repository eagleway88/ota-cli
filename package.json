{
  "name": "@eagleway/ota-cli",
  "version": "2.0.1",
  "description": "CLI and SDK for ota-api",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "ota-cli": "./dist/cli.cjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    "./manage": {
      "import": {
        "types": "./dist/manage.d.ts",
        "default": "./dist/manage.js"
      },
      "require": {
        "types": "./dist/manage.d.cts",
        "default": "./dist/manage.cjs"
      }
    },
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./ws": {
      "import": {
        "types": "./dist/ws.d.ts",
        "default": "./dist/ws.js"
      },
      "require": {
        "types": "./dist/ws.d.cts",
        "default": "./dist/ws.cjs"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      },
      "require": {
        "types": "./dist/node.d.cts",
        "default": "./dist/node.cjs"
      }
    }
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "rimraf dist && tsup && node test/verify-package.cjs",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "test": "node test/run.cjs",
    "test:verify": "pnpm typecheck && pnpm lint && pnpm build && pnpm test",
    "lint": "prettier --check \"src/**/*.ts\" \"test/**/*.cjs\" \"test/**/*.mts\" \"test/**/*.cts\" tsup.config.ts ota-cli.config.ts package.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.cjs\" \"test/**/*.mts\" \"test/**/*.cts\" tsup.config.ts ota-cli.config.ts package.json"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "commander": "^12.1.0",
    "form-data": "^4.0.2",
    "jiti": "^2.4.2"
  },
  "peerDependencies": {
    "axios": ">=1 <2"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/node": "^22.14.1",
    "axios": "^1.13.6",
    "prettier": "3.4.2",
    "rimraf": "^6.0.1",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2"
  }
}
